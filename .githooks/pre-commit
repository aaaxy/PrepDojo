#!/bin/sh
# prepdojo pre-commit guard.
#
# Blocks any commit whose staged changes contain a machine-specific home
# directory path (e.g. a macOS /Users/<you>, a Linux home, or a Windows
# C:\Users\<you>). During daily use of the tracker it's easy to paste a real
# vault path into a template or note; this stops it reaching a public repo.
#
# Enable once per clone:
#     git config core.hooksPath .githooks
#
# Bypass a known-good line (rare) with:  git commit --no-verify

# Scan only added/changed lines in the staged diff. The hook file itself is
# excluded, since it necessarily contains these path patterns as examples.
# .github/ is excluded too: the CI workflow contains this same pattern as
# its own scan pattern, which would otherwise trip the hook.
added=$(git diff --cached --unified=0 --no-color -- . ':(exclude).githooks/' ':(exclude).github/' \
        | grep '^+' | grep -v '^+++')

pattern='(/Users/[^/[:space:]]+|/home/[^/[:space:]]+|[A-Za-z]:\\Users\\[^\\[:space:]]+)'

hits=$(printf '%s\n' "$added" | grep -nE "$pattern")
if [ -n "$hits" ]; then
  echo "pre-commit: refusing to commit — this looks like a personal absolute path:"
  echo
  printf '%s\n' "$hits"
  echo
  echo "Keep your vault path in config.toml (gitignored) or the PREPDOJO_VAULT"
  echo "env var, not in tracked files. If this is genuinely safe to commit,"
  echo "rerun with:  git commit --no-verify"
  exit 1
fi
exit 0